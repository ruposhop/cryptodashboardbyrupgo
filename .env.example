# Copia de referencia. Las variables se crean en Vercel (Settings →
# Environment Variables) y se traen a local con `vercel env pull .env.local`.

# Tu email: el único que puede entrar.
ALLOWED_EMAIL=

# Nombre que se ve en la app y en los emails (opcional).
NEXT_PUBLIC_APP_NAME=Crypto Dashboard by Rupgo
# Opcional: enlace al código en la página de inicio (por defecto, el repo original)
# NEXT_PUBLIC_REPO_URL=

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (emails de acceso y alertas)
RESEND_API_KEY=
# Remitente. Sin dominio verificado en Resend usa el de pruebas (solo entrega
# al email con el que creaste la cuenta de Resend):
# EMAIL_FROM=Crypto Dashboard by Rupgo <onboarding@resend.dev>
EMAIL_FROM=

# Coinbase (API key de SOLO LECTURA: permiso View)
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Zerion (wallets por dirección pública)
ZERION_API_KEY=

# Cualquier texto largo y aleatorio (protege la sincronización automática):
#   openssl rand -hex 32
CRON_SECRET=
